{
    "name": "cinema-plus/backend",
    "description": "cinema+ PHP Backend API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "2.1"
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --no-coverage",
        "phpstan": "phpstan analyse --configuration phpstan.neon --memory-limit=512M"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    }
}
